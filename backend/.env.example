# ---- Server ----
PORT=3000
NODE_ENV=development
# Public base URL of this API (used to build absolute file URLs)
PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed browser origins for the admin panel (mobile apps are not restricted by CORS)
CORS_ORIGINS=http://localhost:5173,https://rudra-kapoor.github.io

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kovi?schema=public

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Google Sign-In: comma-separated OAuth client IDs (web, iOS, Android) whose id_tokens are accepted
GOOGLE_CLIENT_IDS=
# Apple Sign-In: your iOS bundle identifier (aud claim of the Apple identity token)
APPLE_BUNDLE_ID=com.kovi.running

# ---- Admin panel (a first admin is created on boot if no admin exists) ----
ADMIN_EMAIL=admin@kovi.app
ADMIN_PASSWORD=ChangeMe123!

# ---- File storage: "db" (stores files in PostgreSQL, works anywhere) or "local" (./uploads on disk) ----
STORAGE_DRIVER=db
UPLOAD_DIR=./uploads

# ---- Email (password reset codes). MAIL_DRIVER=console logs the email; smtp sends it ----
MAIL_DRIVER=console
MAIL_FROM="Kovi <no-reply@kovi.app>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
