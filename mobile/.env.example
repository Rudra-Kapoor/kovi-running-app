# Copy to .env - Expo inlines EXPO_PUBLIC_* variables into the JS bundle.
# Base URL of the Kovi API (use your machine's LAN IP when testing on a physical device with Expo Go).
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Google Sign-In OAuth client IDs (Google Cloud Console > APIs & Services > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Meta app ID - lets the Instagram Stories share attribute the app (optional)
EXPO_PUBLIC_INSTAGRAM_APP_ID=

# Native map keys are read by app.config.ts at build time
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
